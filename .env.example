# Copy to .env. Never put this key in the browser or commit .env.
GEMINI_API_KEY=
# Verify access for your account; no automatic fallback to a different model.
GEMINI_MODEL=gemini-3.8-live
GEMINI_API_VERSION=v1beta
# Voice interruption tuning. Lower sensitivity reduces accidental speech starts.
VOICE_START_SENSITIVITY=low
VOICE_PREFIX_PADDING_MS=200
VOICE_SILENCE_DURATION_MS=600
# Optional; enable only after verifying endpoint support. Some endpoints reject
# the proactivity field and refuse to connect. Normal interruption tuning works without it.
VOICE_PROACTIVE_AUDIO=false
# Local defaults retain the browser harness and public test registration.
# Production uses deploy/compose.yaml, mounted secrets and stricter validation.
ENVIRONMENT=local
PUBLIC_ORIGIN=
REGISTRATION_ENABLED=true
ENABLE_API_DOCS=true
ENABLE_TEST_HARNESS=true
HTTP_MAX_BODY_BYTES=32768
AUTH_REQUESTS_PER_MINUTE=10
AUTH_GLOBAL_REQUESTS_PER_MINUTE=60
AUTH_MAX_INFLIGHT=4
SESSION_MAX_SECONDS=300
SESSION_IDLE_SECONDS=60
PROVIDER_SETUP_SECONDS=20
IO_TIMEOUT_SECONDS=5
# Optional context compression experiment; disabled for the baseline.
CONTEXT_COMPRESSION=false
# Optional metadata-only JSON report. No audio, transcripts, or prompts are saved.
SAVE_REPORTS=false
# Optional report path, resolved from the repository root when relative.
REPORTS_DIRECTORY=reports
# Local debugging only: save each assistant turn as a 24 kHz mono WAV file.
SAVE_OUTPUT_AUDIO=false
OUTPUT_AUDIO_DIRECTORY=.local/output_audio
# Cost aggregation is intentionally explicit: unknown, per_response, cumulative.
# Keep unknown until usage event semantics have been verified in a live run.
USAGE_MODE=unknown

# Phase 3: backend-only PostgreSQL connection, e.g.
# postgresql+asyncpg://voiceagent_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/voiceagent
DATABASE_URL=
# Optional separate owner connection for migrations and prompt publication.
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
AUTH_SESSION_HOURS=24
ACTIVE_PROMPT_VERSION=phase2-v1

# Phase 4: transient connection recovery (original session deadlines still apply).
CLIENT_RECONNECT_GRACE_SECONDS=10
CLIENT_TRANSPORT_TIMEOUT_SECONDS=15
PROVIDER_RESUME_ATTEMPTS=3
PROVIDER_RESUME_BACKOFF_SECONDS=0.25
# Lease duration must be at least 3x the heartbeat interval.
LEASE_SECONDS=30
LEASE_HEARTBEAT_SECONDS=5

# Phase 5: UTC-day connected-time allowance and creation abuse limit.
DAILY_CONNECTED_SECONDS=900
MINIMUM_SESSION_SECONDS=30
CONVERSATION_CREATIONS_PER_HOUR=10
# Set 0 to disable the hourly conversation-start limit during testing.
# Enable only after USAGE_MODE has been verified against live provider billing.
COST_GUARD_ENABLED=false
DAILY_ESTIMATED_COST_LIMIT_USD=0.60
SESSION_ESTIMATED_COST_LIMIT_USD=0.20
# Stop at 80% of the reserved amount to leave room for delayed/in-flight usage.
COST_GUARD_MARGIN_RATIO=0.20
# Fail closed if provider usage metadata is absent or stale under the enabled guard.
COST_USAGE_TIMEOUT_SECONDS=30

# Phase 6: user memory is opt-in in each profile. No automatic extraction calls.
MEMORY_MAX_ITEMS=20
MEMORY_PROMPT_MAX_ITEMS=5
# UTF-8 bytes of serialized memory JSON, not a token estimate.
MEMORY_PROMPT_MAX_BYTES=1800

# Phase 7: read-only tools also require use_tools=true on conversation creation.
LIVE_TOOLS_ENABLED=false
TOOL_POLICY_VERSION=read-v1
# Lifetime request cap includes invalid calls and duplicate requests.
TOOL_MAX_CALLS=10
TOOL_TIMEOUT_SECONDS=2
TOOL_RESULT_MAX_BYTES=4096
KNOWLEDGE_MAX_PRIVATE_ENTRIES=50
KNOWLEDGE_MAX_SHARED_ENTRIES=200
